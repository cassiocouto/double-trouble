# Unit de usuário do agente do relay. O scripts/install.sh troca @VENV@ e @REPO@.
# Instalado em ~/.config/systemd/user/relay-agent.service
#
# Roda como o seu usuário (systemctl --user), nunca como root: os comandos de
# tela precisam da sua sessão gráfica, e root só aumentaria o estrago.

[Unit]
Description=Relay, agente que roda comandos pré-aprovados
Documentation=file://@REPO@/README.md
After=default.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=notify
NotifyAccess=main
ExecStart=@VENV@/bin/relay-agent
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5
# O agente manda WATCHDOG=1 a cada 30 s. Se travar, o systemd reinicia.
WatchdogSec=60
# Sem Tailscale no boot, o agente espera sozinho e avisa READY em até 30 s.
TimeoutStartSec=90
TimeoutStopSec=20
# Parar o serviço mata tudo que ele iniciou (os jobs e os filhos deles).
KillMode=control-group
Environment=PYTHONUNBUFFERED=1
UMask=0077

# Endurecimento. Só opções que funcionam num unit de usuário e que não quebram
# comandos de desktop. Detalhes no DECISIONS.md (D30).
NoNewPrivileges=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
KeyringMode=private
SystemCallArchitectures=native
SystemCallFilter=~@clock @cpu-emulation @debug @module @obsolete @raw-io @reboot @swap
SystemCallErrorNumber=EPERM
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK

[Install]
WantedBy=default.target
